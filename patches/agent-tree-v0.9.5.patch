+#[test]
+fn tree_header_toggle_is_local_and_never_acknowledges_or_focuses() {
+    let mut state = tree_state(2);
+    state.compose(106, 30).unwrap();
+    let header = state.hits.agent_tree_headers[0].0;
+    let before: Vec<_> = state
+        .snapshot
+        .as_ref()
+        .unwrap()
+        .agents
+        .iter()
+        .map(|agent| agent.agent_status)
+        .collect();
+    let outcome = click(&mut state, header);
+    assert!(outcome.actions.is_empty() && outcome.repaint && !outcome.resize);
+    assert!(state.chrome_drag.is_none() && state.workspace_press.is_none());
+    assert_eq!(leaf_count(&state), 0);
+    state.compose(106, 30).unwrap();
+    assert!(state.hits.agents.is_empty());
+    assert_eq!(
+        state
+            .snapshot
+            .as_ref()
+            .unwrap()
+            .agents
+            .iter()
+            .map(|agent| agent.agent_status)
+            .collect::<Vec<_>>(),
+        before
+    );
+    let outcome = click(&mut state, header);
+    assert!(outcome.actions.is_empty());
+    assert_eq!(leaf_count(&state), 2);
+    state.compose(106, 30).unwrap();
+    let leaf = state.hits.agents[1].0;
+    let outcome = click(&mut state, leaf);
+    assert!(
+        matches!(&outcome.actions[..], [ClientShellAction::Endpoint { request, .. }]
+        if matches!(&request.method, crate::api::schema::Method::PaneFocus(target) if target.pane_id == "pane_2"))
+    );
+}
