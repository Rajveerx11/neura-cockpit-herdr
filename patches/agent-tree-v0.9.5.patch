+        }
+        let start = std::time::Instant::now();
+        for _ in 0..1000 {
+            std::hint::black_box(state.compose(106, 30).unwrap());
+        }
+        eprintln!(
+            "agent-tree {count} panes 106x30: {:.1} us/frame",
+            start.elapsed().as_secs_f64() * 1000.0
+        );
+    }
+}
