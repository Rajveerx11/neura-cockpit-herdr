+#[test]
+fn tree_remote_goto_defers_hidden_ancestor_reveal_until_activation() {
+    let mut state = tree_state(2);
+    let remote = SavedSshEndpoint::new("Remote", "dev@example.invalid", "test").unwrap();
+    let remote_id = ClientEndpointId::Ssh(remote.id.clone());
+    state.set_endpoint_catalog(&[remote]);
+    state.set_endpoint_status(&remote_id, ClientEndpointStatus::Online);
+    let mut projected = state.snapshot.clone().unwrap();
+    projected.boot_id = "remote-boot".into();
+    state.set_endpoint_snapshot(&remote_id, projected);
+    state.compose(106, 40).unwrap();
+    let header = state
+        .hits
+        .agent_tree_headers
+        .iter()
+        .find(|(_, key)| key.endpoint_id == remote_id && key.node == Node::Machine)
+        .unwrap()
+        .0;
+    click(&mut state, header);
+    state.open_navigator_overlay();
+    let Some(ClientShellOverlay::Navigator(navigator)) = state.overlay.as_mut() else {
+        panic!("navigator")
+    };
+    navigator.selected = Some(ClientNavigatorTarget::Pane {
+        endpoint_id: remote_id.clone(),
+        pane_id: "pane_2".into(),
+    });
+    let mut outcome = ClientShellInput::default();
+    state.accept_navigator_selection(&mut outcome);
+    assert_eq!(
+        state.pending_agent_reveal,
+        Some((remote_id.clone(), "pane_2".into()))
+    );
+    assert!(!state.collapsed_agent_tree.is_empty());
+    assert!(state.activate_endpoint_projection(&remote_id));
+    assert!(state.collapsed_agent_tree.is_empty());
+    let mut next_surface = surface();
+    next_surface.boot_id = "remote-boot".into();
+    state.set_pane_surface(next_surface);
+    state.compose(106, 40).unwrap();
+    assert!(state
+        .hits
+        .endpoint_agents
+        .iter()
+        .any(|(_, endpoint, pane)| endpoint == &remote_id && pane == "pane_2"));
+}
+
+#[test]
+fn tree_collapsing_bottom_tab_clamps_scroll_and_keeps_focused_lineage() {
+    let mut state = tree_state(20);
+    let mut projected = state.snapshot.clone().unwrap();
+    let mut second_tab = projected.tabs[0].clone();
+    second_tab.tab_id = "tab_2".into();
+    second_tab.label = "second".into();
+    second_tab.focused = false;
+    projected.tabs.push(second_tab);
+    for index in 18..20 {
+        projected.panes[index].tab_id = "tab_2".into();
+        projected.agents[index].tab_id = "tab_2".into();
+    }
+    state.set_snapshot(projected);
+    let frame = state.compose(106, 30).unwrap();
+    let buffer = frame.to_ratatui_buffer().unwrap();
+    for (rect, _) in &state.hits.agent_tree_headers {
+        assert_eq!(
+            buffer[(rect.x, rect.y)].bg,
+            state.config.palette.active_row_bg
+        );
+    }
+    state.agent_scroll = usize::MAX;
+    state.compose(106, 30).unwrap();
+    let old_max = state.hits.agent_max_scroll;
+    let header = state
+        .hits
+        .agent_tree_headers
+        .iter()
+        .find(|(_, key)| matches!(&key.node, Node::Tab { tab_id, .. } if tab_id == "tab_2"))
+        .unwrap()
+        .0;
+    assert!(click(&mut state, header).actions.is_empty());
+    state.compose(106, 30).unwrap();
+    assert!(state.hits.agent_max_scroll < old_max);
+    assert_eq!(state.agent_scroll, state.hits.agent_max_scroll);
+    assert_eq!(leaf_count(&state), 18);
+}
