diff --git a/src/client/shell/agent_tree.rs b/src/client/shell/agent_tree.rs
new file mode 100644
--- /dev/null
+++ b/src/client/shell/agent_tree.rs
@@ -0,0 +1,496 @@
+//! Expanded grouped Agents presentation; never an input to global agent indices.
+use super::*;
+use crate::api::schema::AgentStatus;
+use ratatui::{
+    text::{Line, Span},
+    widgets::{Paragraph, Widget},
+};
+
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub(super) enum Node {
+    Machine,
+    Workspace(String),
+    Tab {
+        workspace_id: String,
+        tab_id: String,
+    },
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub(super) struct Key {
+    pub(super) endpoint_id: ClientEndpointId,
+    pub(super) boot_id: String,
+    pub(super) node: Node,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) enum Target {
+    Unavailable,
+    Header(Key),
+    Agent {
+        endpoint_id: ClientEndpointId,
+        pane_id: String,
+    },
+}
+
+pub(super) struct Row {
+    pub(super) target: Target,
+    pub(super) label: String,
+    prefix: String,
+    status: Option<AgentStatus>,
+    state_label: Option<String>,
+    focused: bool,
+    stale: bool,
+    collapsed: bool,
+}
+
+pub(super) fn enabled(
+    config: &ClientShellConfig,
+    endpoints: &[ClientShellEndpoint],
+    agent_view_label: Option<&str>,
+) -> bool {
+    config.agent_panel_sort == crate::config::AgentPanelSortConfig::Spaces
+        && agent_view_label.is_none()
+        && endpoints.iter().all(|endpoint| {
+            endpoint
+                .snapshot
+                .as_deref()
+                .is_none_or(|snapshot| snapshot.agent_view_label.is_none())
+                && !matches!(
+                    ClientShellState::endpoint_agent_view(endpoint),
+                    Some(Ok(Some(_))) | Some(Err(()))
+                )
+        })
+}
+
+fn key(endpoint: &ClientEndpointId, snapshot: &ClientShellSnapshot, node: Node) -> Key {
+    Key {
+        endpoint_id: endpoint.clone(),
+        boot_id: snapshot.boot_id.clone(),
+        node,
+    }
+}
+
+fn header(
+    key: Key,
+    label: &str,
+    prefix: String,
+    focused: bool,
+    stale: bool,
+    collapsed: &HashSet<Key>,
+) -> Row {
+    let is_collapsed = collapsed.contains(&key);
+    Row {
+        target: Target::Header(key),
+        label: label.into(),
+        prefix,
+        status: None,
+        state_label: None,
+        focused,
+        stale,
+        collapsed: is_collapsed,
+    }
+}
+
+// All three consumers (draw, scrollbar, reveal) use this row-item projection.
+pub(super) fn rows(
+    endpoints: &[ClientShellEndpoint],
+    active_endpoint: &ClientEndpointId,
+    local_snapshot: Option<&ClientShellSnapshot>,
+    collapsed: &HashSet<Key>,
+) -> Vec<Row> {
+    let mut result = Vec::new();
+    let federated = endpoints.len() > 1;
+    for endpoint in endpoints {
+        let snapshot = if !federated && &endpoint.endpoint_id == active_endpoint {
+            local_snapshot.or(endpoint.snapshot.as_deref())
+        } else {
+            endpoint.snapshot.as_deref()
+        };
+        let Some(snapshot) = snapshot else {
+            result.push(Row {
+                target: Target::Unavailable,
+                label: format!("unavailable: {} (no metadata)", endpoint.label),
+                prefix: String::new(),
+                status: None,
+                state_label: None,
+                focused: false,
+                stale: true,
+                collapsed: false,
+            });
+            continue;
+        };
+        let stale = endpoint.status != ClientEndpointStatus::Online;
+        let active = &endpoint.endpoint_id == active_endpoint;
+        let panes: HashMap<_, _> = snapshot
+            .panes
+            .iter()
+            .map(|pane| (pane.pane_id.as_str(), pane))
+            .collect();
+        let tabs: HashMap<_, _> = snapshot
+            .tabs
+            .iter()
+            .map(|tab| (tab.tab_id.as_str(), tab))
+            .collect();
+        let workspaces: HashSet<_> = snapshot
+            .workspaces
+            .iter()
+            .map(|workspace| workspace.workspace_id.as_str())
+            .collect();
+        let mut agents_by_tab: HashMap<&str, Vec<&crate::protocol::ClientShellAgent>> =
+            HashMap::new();
+        let mut missing_membership = 0;
+        for agent in &snapshot.agents {
+            let tab = tabs.get(agent.tab_id.as_str());
+            // Pane metadata is optional in cached snapshots; only positive conflicts invalidate membership.
+            if panes.get(agent.pane_id.as_str()).is_some_and(|pane| {
+                pane.tab_id != agent.tab_id || pane.workspace_id != agent.workspace_id
+            }) || tab.is_some_and(|tab| tab.workspace_id != agent.workspace_id)
+            {
+                continue;
+            }
+            if tab.is_none() || !workspaces.contains(agent.workspace_id.as_str()) {
+                missing_membership += 1;
+                continue;
+            }
+            agents_by_tab.entry(&agent.tab_id).or_default().push(agent);
+        }
+        let mut tabs_by_workspace: HashMap<&str, Vec<&crate::protocol::ClientShellTab>> =
+            HashMap::new();
+        for tab in &snapshot.tabs {
+            if agents_by_tab.contains_key(tab.tab_id.as_str()) {
+                tabs_by_workspace
+                    .entry(&tab.workspace_id)
+                    .or_default()
+                    .push(tab);
+            }
+        }
+        if federated || stale {
+            let machine_key = key(&endpoint.endpoint_id, snapshot, Node::Machine);
+            let label = if endpoints
+                .iter()
+                .filter(|other| other.label == endpoint.label)
+                .count()
+                > 1
+            {
+                format!(
+                    "{} [{}]",
+                    endpoint.label,
+                    endpoint.endpoint_id.storage_key()
+                )
+            } else {
+                endpoint.label.clone()
+            };
+            result.push(header(
+                machine_key.clone(),
+                &label,
+                String::new(),
+                active,
+                stale,
+                collapsed,
+            ));
+            if collapsed.contains(&machine_key) {
+                continue;
+            }
+        }
+        if missing_membership > 0 {
+            result.push(Row {
+                target: Target::Unavailable,
+                label: format!(
+                    "unavailable: group metadata for {missing_membership} native agent(s)"
+                ),
+                prefix: String::new(),
+                status: None,
+                state_label: None,
+                focused: false,
+                stale: true,
+                collapsed: false,
+            });
+        }
+        for workspace in &snapshot.workspaces {
+            let Some(workspace_tabs) = tabs_by_workspace.get(workspace.workspace_id.as_str())
+            else {
+                continue;
+            };
+            let workspace_key = key(
+                &endpoint.endpoint_id,
+                snapshot,
+                Node::Workspace(workspace.workspace_id.clone()),
+            );
+            let focused =
+                active && snapshot.focused_workspace_id.as_deref() == Some(&workspace.workspace_id);
+            let base = if federated { "  " } else { "" };
+            result.push(header(
+                workspace_key.clone(),
+                &workspace.label,
+                base.into(),
+                focused,
+                stale,
+                collapsed,
+            ));
+            if collapsed.contains(&workspace_key) {
+                continue;
+            }
+            for (tab_index, tab) in workspace_tabs.iter().enumerate() {
+                let last_tab = tab_index + 1 == workspace_tabs.len();
+                let tab_key = key(
+                    &endpoint.endpoint_id,
+                    snapshot,
+                    Node::Tab {
+                        workspace_id: workspace.workspace_id.clone(),
+                        tab_id: tab.tab_id.clone(),
+                    },
+                );
+                result.push(header(
+                    tab_key.clone(),
+                    &tab.label,
+                    format!("{base}{}", if last_tab { "└─ " } else { "├─ " }),
+                    focused && snapshot.focused_tab_id.as_deref() == Some(&tab.tab_id),
+                    stale,
+                    collapsed,
+                ));
+                if collapsed.contains(&tab_key) {
+                    continue;
+                }
+                let Some(agents) = agents_by_tab.get(tab.tab_id.as_str()) else {
+                    continue;
+                };
+                for (index, agent) in agents.iter().enumerate() {
+                    let label = agent
+                        .name
+                        .as_deref()
+                        .filter(|label| !label.trim().is_empty())
+                        .or(agent.display_agent.as_deref())
+                        .or(agent.agent.as_deref())
+                        .or(agent.title.as_deref())
+                        .unwrap_or(&agent.pane_id);
+                    result.push(Row {
+                        target: Target::Agent {
+                            endpoint_id: endpoint.endpoint_id.clone(),
+                            pane_id: agent.pane_id.clone(),
+                        },
+                        label: label.into(),
+                        prefix: format!(
+                            "{base}{}{}",
+                            if last_tab { "   " } else { "│  " },
+                            if index + 1 == agents.len() {
+                                "└─ "
+                            } else {
+                                "├─ "
+                            }
+                        ),
+                        status: Some(agent.agent_status),
+                        state_label: agent
+                            .state_labels
+                            .iter()
+                            .find(|(state, _)| state == status_text(agent.agent_status))
+                            .map(|(_, label)| label.clone()),
+                        focused: active && agent.focused,
+                        stale,
+                        collapsed: false,
+                    });
+                }
+            }
+        }
+    }
+    result
+}
+
+pub(super) fn render(
+    buffer: &mut Buffer,
+    area: Rect,
+    rows: &[Row],
+    config: &ClientShellConfig,
+    agent_scroll: &mut usize,
+    hits: &mut ShellHitMap,
+    federated: bool,
+) {
+    super::agent_sidebar::render_agent_list(
+        buffer,
+        area,
+        rows,
+        Some(" no agents"),
+        config,
+        agent_scroll,
+        hits,
+        |_| 1,
+        |buffer, rect, row, hits| {
+            let palette = &config.palette;
+            let style = Style::default()
+                .fg(if row.stale {
+                    palette.overlay0
+                } else {
+                    palette.text
+                })
+                .bg(if row.focused {
+                    palette.active_row_bg
+                } else {
+                    palette.sidebar_bg
+                });
+            let marker = match row.status {
+                Some(status) => format!(
+                    "{} {} ",
+                    status_icon(status, config.status_indicators),
+                    row.state_label
+                        .as_deref()
+                        .unwrap_or_else(|| status_text(status))
+                ),
+                None if row.target == Target::Unavailable => "? ".into(),
+                None => format!(
+                    "{}{}",
+                    if row.collapsed { "▸ " } else { "▾ " },
+                    if row.stale { "stale " } else { "" }
+                ),
+            };
+            let marker_style = Style::default().fg(if row.stale {
+                palette.overlay0
+            } else {
+                row.status
+                    .map_or(palette.subtext0, |status| status_color(status, palette))
+            });
+            let prefix = if rect.width > 12 {
+                row.prefix.as_str()
+            } else {
+                ""
+            };
+            let label: String = row.label.chars().filter(|ch| !ch.is_control()).collect();
+            let marker: String = marker.chars().filter(|ch| !ch.is_control()).collect();
+            Paragraph::new(Line::from(vec![
+                Span::raw(prefix),
+                Span::styled(marker, marker_style),
+                Span::styled(
+                    label,
+                    if row.focused {
+                        style.add_modifier(Modifier::BOLD)
+                    } else {
+                        style
+                    },
+                ),
+                Span::raw(if row.stale && row.target != Target::Unavailable {
+                    " (stale)"
+                } else {
+                    ""
+                }),
+            ]))
+            .style(style)
+            .render(rect, buffer);
+            if !config.mouse_capture {
+                return;
+            }
+            match &row.target {
+                Target::Unavailable => {}
+                Target::Header(key) => hits.agent_tree_headers.push((rect, key.clone())),
+                Target::Agent {
+                    endpoint_id,
+                    pane_id,
+                } if federated => {
+                    hits.endpoint_agents
+                        .push((rect, endpoint_id.clone(), pane_id.clone()))
+                }
+                Target::Agent { pane_id, .. } => hits.agents.push((rect, pane_id.clone())),
+            }
+        },
+    );
+}
+
+impl ClientShellState {
+    pub(super) fn reveal_tree_agent(
+        &mut self,
+        endpoint_id: &ClientEndpointId,
+        pane_id: &str,
+        body_height: u16,
+    ) -> bool {
+        let label = self
+            .snapshot
+            .as_deref()
+            .and_then(|snapshot| snapshot.agent_view_label.as_deref());
+        if self.sidebar_collapsed || !enabled(&self.config, &self.endpoints, label) {
+            return false;
+        }
+        let Some(snapshot) = self
+            .endpoints
+            .iter()
+            .find(|endpoint| &endpoint.endpoint_id == endpoint_id)
+            .and_then(|endpoint| {
+                if self.endpoints.len() == 1 && endpoint_id == &self.active_endpoint_id {
+                    self.snapshot.as_deref().or(endpoint.snapshot.as_deref())
+                } else {
+                    endpoint.snapshot.as_deref()
+                }
+            })
+        else {
+            return true;
+        };
+        let Some(agent) = snapshot
+            .agents
+            .iter()
+            .find(|agent| agent.pane_id == pane_id)
+        else {
+            return true;
+        };
+        for node in [
+            Node::Machine,
+            Node::Workspace(agent.workspace_id.clone()),
+            Node::Tab {
+                workspace_id: agent.workspace_id.clone(),
+                tab_id: agent.tab_id.clone(),
+            },
+        ] {
+            self.collapsed_agent_tree
+                .remove(&key(endpoint_id, snapshot, node));
+        }
+        let rows = rows(
+            &self.endpoints,
+            &self.active_endpoint_id,
+            self.snapshot.as_deref(),
+            &self.collapsed_agent_tree,
+        );
+        let target = Target::Agent {
+            endpoint_id: endpoint_id.clone(),
+            pane_id: pane_id.into(),
+        };
+        if let Some(index) = rows.iter().position(|row| row.target == target) {
+            let heights = vec![1; rows.len()];
+            let mut gaps = vec![self.config.agents.row_gap; rows.len()];
+            if let Some(last) = gaps.last_mut() {
+                *last = 0;
+            }
+            self.agent_scroll = super::scroll::list_scroll_start_to_reveal(
+                &heights,
+                &gaps,
+                body_height,
+                self.agent_scroll,
+                index,
+            );
+        }
+        true
+    }
+
+    pub(super) fn toggle_agent_tree_at(&mut self, point: (u16, u16)) -> bool {
+        let Some(key) = self
+            .hits
+            .agent_tree_headers
+            .iter()
+            .find(|(rect, _)| super::contains(*rect, point))
+            .map(|(_, key)| key.clone())
+        else {
+            return false;
+        };
+        // Old hit rectangles must not collapse reused IDs after a server restart.
+        if !self.endpoints.iter().any(|endpoint| {
+            endpoint.endpoint_id == key.endpoint_id
+                && (if self.endpoints.len() == 1 && key.endpoint_id == self.active_endpoint_id {
+                    self.snapshot.as_deref().or(endpoint.snapshot.as_deref())
+                } else {
+                    endpoint.snapshot.as_deref()
+                })
+                .is_some_and(|snapshot| snapshot.boot_id == key.boot_id)
+        }) {
+            return true;
+        }
+        if !self.collapsed_agent_tree.remove(&key) {
+            self.collapsed_agent_tree.insert(key);
+        }
+        true
+    }
+}
