+use super::*;
+use crate::client::shell::agent_tree::{self, Node, Target};
+
+fn tree_state(count: usize) -> ClientShellState {
+    let mut projected = snapshot();
+    projected.panes = (0..count)
+        .map(|index| ClientShellPane {
+            pane_id: format!("pane_{}", index + 1),
+            focused: index == 0,
+            ..projected.panes[0].clone()
+        })
+        .collect();
+    projected.agents = projected
+        .panes
+        .iter()
+        .enumerate()
+        .map(|(index, pane)| ClientShellAgent {
+            pane_id: pane.pane_id.clone(),
+            workspace_id: pane.workspace_id.clone(),
+            tab_id: pane.tab_id.clone(),
+            name: Some(format!("worker-{index}")),
+            display_agent: Some("harness fallback".into()),
+            agent: Some("codex".into()),
+            title: Some("title fallback".into()),
+            terminal_title: None,
+            terminal_title_stripped: None,
+            agent_status: AgentStatus::Blocked,
+            state_change_seq: 1,
+            state_labels: Vec::new(),
+            tokens: Vec::new(),
+            focused: pane.focused,
+        })
+        .collect();
+    let mut config = Config::default();
+    config.ui.sidebar.agents.row_gap = 0;
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(surface());
+    state
+}
+
+fn tree_rows(state: &ClientShellState) -> Vec<agent_tree::Row> {
+    agent_tree::rows(
+        &state.endpoints,
+        &state.active_endpoint_id,
+        state.snapshot.as_deref(),
+        &state.collapsed_agent_tree,
+    )
+}
+
+fn leaf_count(state: &ClientShellState) -> usize {
+    tree_rows(state)
+        .iter()
+        .filter(|row| matches!(row.target, Target::Agent { .. }))
+        .count()
+}
+
+fn click(state: &mut ClientShellState, rect: Rect) -> ClientShellInput {
+    state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: rect.x,
+        row: rect.y,
+        modifiers: KeyModifiers::NONE,
+    })])
+}
+
+fn frame_text(frame: &crate::client::frame_output::ComposedFrame) -> String {
+    frame
+        .cells
+        .iter()
+        .map(|cell| cell.symbol.as_str())
+        .collect()
+}
