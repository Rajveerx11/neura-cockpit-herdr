+#[test]
+fn tree_membership_keeps_optional_metadata_and_rejects_conflicts() {
+    let mut state = tree_state(3);
+    let mut projected = state.snapshot.clone().unwrap();
+    projected.panes.remove(0);
+    projected.agents[1].tab_id = "missing".into();
+    state.set_snapshot(projected.clone());
+    assert_eq!(
+        leaf_count(&state),
+        2,
+        "missing optional pane does not mean closed"
+    );
+    let mut tab = projected.tabs[0].clone();
+    tab.tab_id = "tab_2".into();
+    tab.label = "moved".into();
+    projected.tabs.push(tab);
+    projected.panes[1].tab_id = "tab_2".into();
+    projected.agents[2].tab_id = "tab_2".into();
+    state.set_snapshot(projected.clone());
+    assert!(tree_rows(&state).iter().any(|row| row.label == "moved"));
+    projected.agents.remove(0);
+    state.set_snapshot(projected.clone());
+    assert_eq!(
+        leaf_count(&state),
+        1,
+        "closed agents leave the native inventory"
+    );
+    projected.panes[1].workspace_id = "conflicting-workspace".into();
+    state.set_snapshot(projected.clone());
+    assert_eq!(
+        leaf_count(&state),
+        0,
+        "positive membership conflicts are rejected"
+    );
+    projected.tabs.clear();
+    state.set_snapshot(projected);
+    assert!(tree_rows(&state).is_empty(), "no empty ghost groups");
+}
