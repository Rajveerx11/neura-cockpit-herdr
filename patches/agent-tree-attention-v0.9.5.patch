+#[test]
+fn tree_attention_endpoint_boot_and_hidden_updates_are_isolated() {
+    let mut state = tree_state(2);
+    let remote = SavedSshEndpoint::new("Remote", "dev@example.invalid", "test").unwrap();
+    let remote_id = ClientEndpointId::Ssh(remote.id.clone());
+    state.set_endpoint_catalog(&[remote]);
+    state.set_endpoint_status(&remote_id, ClientEndpointStatus::Online);
+    let mut projected = state.snapshot.clone().unwrap();
+    projected.boot_id = "remote-boot".into();
+    projected.agents[0].agent_status = AgentStatus::Done;
+    projected.agents.remove(1);
+    attention_snapshot(&mut state, &remote_id, projected.clone());
+    collapse_node(&mut state, &ClientEndpointId::Local, Node::Machine);
+    collapse_node(&mut state, &remote_id, Node::Machine);
+    let rows = tree_rows(&state);
+    assert_eq!(rows.len(), 2);
+    assert!(rows[0].label.ends_with(" | 2 blocked"));
+    assert_eq!(rows[1].label, "Remote | 1 native done");
+    projected.revision += 3;
+    projected.agents[0].state_change_seq += 3;
+    projected.agents[0].agent_status = AgentStatus::Unknown;
+    state.set_endpoint_snapshot(&remote_id, projected.clone());
+    assert_eq!(tree_rows(&state)[1].label, "Remote | 1 unknown");
+    state.set_endpoint_status(&remote_id, ClientEndpointStatus::Reconnecting);
+    let frame = state.compose(106, 40).unwrap();
+    assert!(frame_text(&frame).contains("stale Remote"));
+    let (rect, _) = state
+        .hits
+        .agent_tree_headers
+        .iter()
+        .find(|(_, key)| key.endpoint_id == remote_id)
+        .unwrap();
+    assert_eq!(
+        frame.to_ratatui_buffer().unwrap()[(rect.x, rect.y)].fg,
+        state.config.palette.overlay0
+    );
+    projected.boot_id = "new-remote-boot".into();
+    state.set_endpoint_snapshot(&remote_id, projected);
+    assert!(tree_rows(&state)[0].label.ends_with(" | 2 blocked"));
+    assert_eq!(tree_rows(&state)[1].label, "Remote");
+    assert_eq!(leaf_count(&state), 1);
+}
