+#[test]
+fn tree_attention_counts_whole_nested_subtrees_and_native_states() {
+    let mut state = tree_state(7);
+    let mut projected = state.snapshot.clone().unwrap();
+    let workspace_id = projected.workspaces[0].workspace_id.clone();
+    let tab_id = projected.tabs[0].tab_id.clone();
+    let mut second_tab = projected.tabs[0].clone();
+    second_tab.tab_id = "second".into();
+    second_tab.label = "second".into();
+    projected.tabs.push(second_tab.clone());
+    let mut second_workspace = projected.workspaces[0].clone();
+    second_workspace.workspace_id = "other".into();
+    second_workspace.label = "other".into();
+    projected.workspaces.push(second_workspace);
+    second_tab.tab_id = "third".into();
+    second_tab.workspace_id = "other".into();
+    projected.tabs.push(second_tab);
+    for (index, status) in [
+        AgentStatus::Blocked,
+        AgentStatus::Working,
+        AgentStatus::Done,
+        AgentStatus::Idle,
+        AgentStatus::Unknown,
+        AgentStatus::Blocked,
+        AgentStatus::Done,
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        projected.agents[index].agent_status = status;
+        projected.agents[index].state_labels = vec![("done".into(), "reviewed".into())];
+        if index >= 5 {
+            let tab = if index == 5 { "second" } else { "third" };
+            projected.agents[index].tab_id = tab.into();
+            projected.panes[index].tab_id = tab.into();
+        }
+    }
+    projected.agents[6].workspace_id = "other".into();
+    projected.panes[6].workspace_id = "other".into();
+    attention_snapshot(&mut state, &ClientEndpointId::Local, projected);
+    let expanded: Vec<_> = tree_rows(&state).into_iter().map(|row| row.label).collect();
+    collapse_node(
+        &mut state,
+        &ClientEndpointId::Local,
+        Node::Tab {
+            workspace_id: workspace_id.clone(),
+            tab_id,
+        },
+    );
+    let rows = tree_rows(&state);
+    assert!(rows.iter().any(|row| {
+        row.label
+            .ends_with(" | 1 blocked 1 working 1 native done 1 idle 1 unknown")
+    }));
+    assert_eq!(leaf_count(&state), 2);
+    collapse_node(
+        &mut state,
+        &ClientEndpointId::Local,
+        Node::Workspace(workspace_id),
+    );
+    assert!(tree_rows(&state).iter().any(|row| {
+        row.label
+            .ends_with(" | 2 blocked 1 working 1 native done 1 idle 1 unknown")
+    }));
+    assert_eq!(leaf_count(&state), 1);
+    collapse_node(
+        &mut state,
+        &ClientEndpointId::Local,
+        Node::Workspace("other".into()),
+    );
+    assert!(tree_rows(&state)
+        .iter()
+        .any(|row| row.label == "other | 1 native done"));
+    assert_eq!(leaf_count(&state), 0);
+    state.set_endpoint_status(&ClientEndpointId::Local, ClientEndpointStatus::Reconnecting);
+    collapse_node(&mut state, &ClientEndpointId::Local, Node::Machine);
+    assert_eq!(tree_rows(&state).len(), 1);
+    assert!(tree_rows(&state)[0]
+        .label
+        .ends_with(" | 2 blocked 1 working 2 native done 1 idle 1 unknown"));
+    state.collapsed_agent_tree.clear();
+    state.set_endpoint_status(&ClientEndpointId::Local, ClientEndpointStatus::Online);
+    assert_eq!(
+        tree_rows(&state)
+            .into_iter()
+            .map(|row| row.label)
+            .collect::<Vec<_>>(),
+        expanded
+    );
+}
