+#[test]
+fn tree_attention_38_columns_preserve_workspace_and_tab_identity_before_counts() {
+    for is_tab in [false, true] {
+        let mut state = tree_state(1);
+        let mut projected = state.snapshot.clone().unwrap();
+        projected.workspaces[0].label = "Workspace".into();
+        projected.tabs[0].label = "Build".into();
+        projected.agents[0].agent_status = AgentStatus::Done;
+        let workspace_id = projected.workspaces[0].workspace_id.clone();
+        let node = if is_tab {
+            Node::Tab {
+                workspace_id,
+                tab_id: projected.tabs[0].tab_id.clone(),
+            }
+        } else {
+            Node::Workspace(workspace_id)
+        };
+        attention_snapshot(&mut state, &ClientEndpointId::Local, projected);
+        collapse_node(&mut state, &ClientEndpointId::Local, node);
+        let area = Rect::new(0, 0, 38, 6);
+        let mut buffer = Buffer::empty(area);
+        agent_tree::render(
+            &mut buffer,
+            area,
+            &tree_rows(&state),
+            &state.config,
+            &mut 0,
+            &mut ShellHitMap::default(),
+            false,
+        );
+        let text: String = buffer.content.iter().map(|cell| cell.symbol()).collect();
+        let expected = if is_tab {
+            "Build | 1 native done"
+        } else {
+            "Workspace | 1 native done"
+        };
+        assert!(text.contains(expected), "{text}");
+    }
