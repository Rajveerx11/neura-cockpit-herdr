+#[derive(Default)]
+struct Counts {
+    states: [usize; 5],
+    unavailable: usize,
+}
+
+impl Counts {
+    fn add(&mut self, status: AgentStatus) {
+        let index = match status {
+            AgentStatus::Blocked => 0,
+            AgentStatus::Working => 1,
+            AgentStatus::Done => 2,
+            AgentStatus::Idle => 3,
+            AgentStatus::Unknown => 4,
+        };
+        self.states[index] += 1;
+    }
+
+    fn summary(&self) -> String {
+        let [blocked, working, done, idle, unknown] = self.states;
+        [
+            (self.unavailable, "unavailable"),
+            (blocked, "blocked"),
+            (working, "working"),
+            (done, "native done"),
+            (idle, "idle"),
+            (unknown, "unknown"),
+        ]
+        .into_iter()
+        .filter(|(count, _)| *count > 0)
+        .map(|(count, label)| format!("{count} {label}"))
+        .collect::<Vec<_>>()
+        .join(" ")
+    }
+}
