+fn collapse_node(state: &mut ClientShellState, endpoint: &ClientEndpointId, node: Node) {
+    let key = tree_rows(state)
+        .into_iter()
+        .find_map(|row| match row.target {
+            Target::Header(key) if &key.endpoint_id == endpoint && key.node == node => Some(key),
+            _ => None,
+        })
+        .unwrap();
+    state.collapsed_agent_tree.insert(key);
+}
+
+fn attention_snapshot(
+    state: &mut ClientShellState,
+    endpoint: &ClientEndpointId,
+    mut projected: Box<ClientShellSnapshot>,
+) {
+    // Native Done requires an observed completion beyond the client's initial seen watermark.
+    let mut working = projected.clone();
+    working.revision += 1;
+    projected.revision += 2;
+    for (before, after) in working.agents.iter_mut().zip(&mut projected.agents) {
+        if after.agent_status == AgentStatus::Done {
+            before.agent_status = AgentStatus::Working;
+            before.state_change_seq += 1;
+            after.agent_status = AgentStatus::Idle;
+            after.state_change_seq += 2;
+        }
+    }
+    state.set_endpoint_snapshot(endpoint, working);
+    state.set_endpoint_snapshot(endpoint, projected);
+    if endpoint == &state.active_endpoint_id {
+        // No coherent displayed surface: the native completion remains unacknowledged.
+        state.pane_surface = None;
+    }
+}
