+#[test]
+fn tree_attention_narrow_headers_remain_single_line_and_action_free() {
+    let mut state = tree_state(1);
+    let mut projected = state.snapshot.clone().unwrap();
+    projected.agents[0].agent_status = AgentStatus::Done;
+    projected.workspaces[0].label = "long workspace\n\u{1b}".repeat(10);
+    attention_snapshot(&mut state, &ClientEndpointId::Local, projected);
+    state.compose(106, 30).unwrap();
+    let header = state.hits.agent_tree_headers[0].0;
+    let before = state.snapshot.clone().unwrap();
+    assert!(click(&mut state, header).actions.is_empty());
+    let rows = tree_rows(&state);
+    for width in [0, 1, 4, 8, 12, 20, 36, 38, 80] {
+        let area = Rect::new(0, 0, width, 6);
+        let mut buffer = Buffer::empty(area);
+        let mut hits = ShellHitMap::default();
+        agent_tree::render(
+            &mut buffer,
+            area,
+            &rows,
+            &state.config,
+            &mut 0,
+            &mut hits,
+            false,
+        );
+        assert!(hits.agents.is_empty() && hits.endpoint_agents.is_empty());
+        for (rect, _) in &hits.agent_tree_headers {
+            assert!(rect.right() <= width && rect.height == 1);
+        }
+        let text: String = buffer.content.iter().map(|cell| cell.symbol()).collect();
+        assert!(!text.chars().any(char::is_control));
+        if width >= 20 {
+            assert!(text.contains("long workspace"));
+        }
+    }
+    state.compose(106, 30).unwrap();
+    assert!(click(&mut state, header).actions.is_empty());
+    assert_eq!(
+        state.snapshot.as_ref().unwrap().agents[0].agent_status,
+        AgentStatus::Done
+    );
+    assert_eq!(
+        state.snapshot.as_ref().unwrap().agents[0].state_change_seq,
+        before.agents[0].state_change_seq
+    );
+    assert_eq!(leaf_count(&state), 1);
+}
