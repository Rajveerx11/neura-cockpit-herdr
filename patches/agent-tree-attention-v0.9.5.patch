+#[test]
+fn tree_attention_missing_and_conflicting_membership_fail_closed() {
+    let mut state = tree_state(5);
+    let mut projected = state.snapshot.clone().unwrap();
+    let workspace = projected.workspaces[0].workspace_id.clone();
+    // Missing optional panes remain valid; missing parents and positive conflicts do not.
+    projected.panes.retain(|pane| pane.pane_id == "pane_4");
+    projected.agents[0].agent_status = AgentStatus::Unknown;
+    projected.agents[1].tab_id = "missing".into();
+    projected.agents[2].workspace_id = "conflict".into();
+    projected.panes[0].tab_id = "conflict".into();
+    let mut orphan_tab = projected.tabs[0].clone();
+    orphan_tab.tab_id = "orphan".into();
+    orphan_tab.workspace_id = "missing".into();
+    projected.tabs.push(orphan_tab);
+    projected.agents[4].tab_id = "orphan".into();
+    projected.agents[4].workspace_id = "missing".into();
+    state.set_snapshot(projected);
+    collapse_node(
+        &mut state,
+        &ClientEndpointId::Local,
+        Node::Workspace(workspace),
+    );
+    let rows = tree_rows(&state);
+    assert_eq!(rows.len(), 2);
+    assert_eq!(rows[0].target, Target::Unavailable);
+    assert!(rows[0].label.contains("2 native agent(s)"));
+    assert!(rows[1].label.ends_with(" | 1 unknown"));
+    state.set_endpoint_status(&ClientEndpointId::Local, ClientEndpointStatus::Reconnecting);
+    collapse_node(&mut state, &ClientEndpointId::Local, Node::Machine);
+    assert!(tree_rows(&state)[0]
+        .label
+        .ends_with(" | 2 unavailable 1 unknown"));
+    let mut projected = state.snapshot.clone().unwrap();
+    projected.tabs.clear();
+    state.set_snapshot(projected);
+    let rows = tree_rows(&state);
+    assert_eq!(rows.len(), 1);
+    assert!(rows[0].label.ends_with(" | 4 unavailable"));
+    assert!(!rows[0].label.contains("unknown"));
+
+    // Conflicting duplicate tab metadata must not fabricate workspace counts or panic.
+    let mut state = tree_state(1);
+    let mut projected = state.snapshot.clone().unwrap();
+    let mut other = projected.workspaces[0].clone();
+    other.workspace_id = "other".into();
+    other.label = "other".into();
+    projected.workspaces.push(other);
+    let mut conflicting_tab = projected.tabs[0].clone();
+    conflicting_tab.workspace_id = "other".into();
+    projected.tabs.insert(0, conflicting_tab);
+    state.set_snapshot(projected);
+    collapse_node(
+        &mut state,
+        &ClientEndpointId::Local,
+        Node::Workspace("other".into()),
+    );
+    assert!(tree_rows(&state).iter().any(|row| row.label == "other"));
+}
