+/// Reuse bounded image staging, translating the path through the local WSL
+/// distribution instead of assuming its automount prefix. Never changes the clipboard.
+pub(crate) fn stage_clipboard_image_for_wsl(image: &ClipboardImage) -> std::io::Result<String> {
+    use std::process::Stdio;
+    if image.bytes.len() > crate::protocol::MAX_CLIPBOARD_IMAGE_PAYLOAD {
+        return Err(std::io::Error::other(
+            "clipboard image exceeds the payload limit",
+        ));
+    }
+    let staged = crate::server::clipboard_image::stage(
+        u64::from(std::process::id()),
+        image.extension,
+        &image.bytes,
+    )?;
+    let converted = (|| {
+        // shortcut: uses default WSL distribution; select per-pane distro for multi-distro support.
+        let mut child = crate::noninteractive_process::command("wsl.exe")
+            .args(["--exec", "wslpath", "-u"])
+            .arg(&staged.path)
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .spawn()?;
+        let deadline = Instant::now() + Duration::from_secs(3);
+        while child.try_wait()?.is_none() {
+            if Instant::now() >= deadline {
+                let _ = child.kill();
+                let _ = child.wait();
+                return Err(std::io::Error::new(
+                    std::io::ErrorKind::TimedOut,
+                    "WSL image path translation timed out",
+                ));
+            }
+            std::thread::sleep(Duration::from_millis(10));
+        }
+        let output = child.wait_with_output()?;
+        if !output.status.success() {
+            return Err(std::io::Error::other("WSL image path translation failed"));
+        }
+        parse_wsl_clipboard_path(&output.stdout)
+    })();
+    if converted.is_err() {
+        crate::server::clipboard_image::remove_files(vec![staged.path]);
+    }
+    converted
+}
