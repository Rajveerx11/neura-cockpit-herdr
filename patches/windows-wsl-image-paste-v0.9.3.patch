+#[test]
+fn clipboard_image_wsl_routing_preserves_native_panes_and_modal_ownership() {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    let mut resources = snapshot();
+    assert_eq!(resources.panes[0].foreground_cwd.as_deref(), Some("/repo"));
+    state.set_snapshot(Box::new(resources.clone()));
+    assert!(state.clipboard_image_targets_wsl());
+
+    resources.panes[0].cwd = Some(r"C:\repo".into());
+    resources.panes[0].foreground_cwd = Some(r"C:\repo".into());
+    state.set_snapshot(Box::new(resources.clone()));
+    assert!(!state.clipboard_image_targets_wsl());
+
+    resources.agents.push(ClientShellAgent {
+        pane_id: "pane_1".into(),
+        workspace_id: "ws_1".into(),
+        tab_id: "tab_1".into(),
+        name: None,
+        display_agent: None,
+        agent: Some("fx".into()),
+        title: None,
+        terminal_title: None,
+        terminal_title_stripped: None,
+        agent_status: AgentStatus::Idle,
+        state_change_seq: 0,
+        state_labels: Vec::new(),
+        tokens: Vec::new(),
+        focused: true,
+    });
+    state.set_snapshot(Box::new(resources.clone()));
+    assert!(state.clipboard_image_targets_wsl());
+    let mut missing_pane = resources.clone();
+    missing_pane.panes.clear();
+    state.set_snapshot(Box::new(missing_pane));
+    assert!(!state.clipboard_image_targets_wsl());
+    // An unrelated fx pane must never redirect a native Windows paste.
+    resources.agents[0].pane_id = "other-pane".into();
+    state.set_snapshot(Box::new(resources));
+    assert!(!state.clipboard_image_targets_wsl());
+
+    state.set_snapshot(Box::new(snapshot()));
+    state.mode = ClientShellMode::Prefix;
+    assert!(!state.clipboard_image_targets_wsl());
+    state.mode = ClientShellMode::Copy;
+    assert!(!state.clipboard_image_targets_wsl());
+    state.mode = ClientShellMode::Terminal;
+    state.overlay = Some(ClientShellOverlay::Onboarding);
+    assert!(!state.clipboard_image_targets_wsl());
+    state.overlay = None;
+    state.popup_pending = true;
+    assert!(!state.clipboard_image_targets_wsl());
+    state.popup_pending = false;
+    state.set_pane_surface(surface_with_popup());
+    assert!(!state.clipboard_image_targets_wsl());
