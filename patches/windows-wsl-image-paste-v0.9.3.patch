+        .expect("read own staged PNG from WSL");
+    assert!(output.status.success());
+    assert_eq!(output.stdout, image.bytes);
+    let cleanup = crate::noninteractive_process::command("wsl.exe")
+        .args(["--exec", "rm", "--", &path])
+        .status()
+        .expect("remove own fixture");
+    assert!(cleanup.success());
