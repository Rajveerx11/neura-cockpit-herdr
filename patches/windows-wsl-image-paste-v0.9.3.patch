+            ClientInputEvent::FocusLost,
+        ]
+    );
+    assert!(!events.iter().any(|event| matches!(
+        event.to_raw_input_event(),
+        crate::raw_input::RawInputEvent::Key(key) if key.code == crossterm::event::KeyCode::Enter
+    )));
+    assert!(matches!(
+        batch[0],
+        ClientLoopEvent::Resize(120, 40, 8, 16, true)
+    ));
+    assert!(matches!(
