+fn wsl_clipboard_paste_text_quotes_spaces_and_shell_metacharacters() {
+    assert_eq!(
+        wsl_clipboard_paste_text("/mnt/c/Users/Test User/image.png"),
+        "\"/mnt/c/Users/Test User/image.png\""
+    );
+    assert_eq!(
+        wsl_clipboard_paste_text("/tmp/a'\\\"$`;.png"),
+        "\"/tmp/a'\\\\\\\"\\$\\`;.png\""
+    );
+}
+
+fn parse_wsl_clipboard_path(output: &[u8]) -> std::io::Result<String> {
+    let path = std::str::from_utf8(output)
+        .map_err(|_| std::io::Error::other("WSL image path is not UTF-8"))?
+        .trim_end_matches(['\r', '\n']);
+    if !path.starts_with('/') || path.chars().any(char::is_control) {
+        return Err(std::io::Error::other(
+            "WSL image path is not a single absolute path",
+        ));
+    }
+    Ok(path.to_owned())
+}
+
+#[cfg(test)]
+#[test]
+fn wsl_clipboard_path_requires_one_absolute_path_and_preserves_spaces() {
+    assert_eq!(
+        parse_wsl_clipboard_path(b"/mnt/c/Users/Test User/image.png\r\n").unwrap(),
+        "/mnt/c/Users/Test User/image.png"
+    );
+    for invalid in [
+        &b"C:\\image.png"[..],
+        b"",
+        b"relative.png",
+        b"/tmp/one\n/tmp/two",
+        b"/tmp/\xff",
+    ] {
+        assert!(parse_wsl_clipboard_path(invalid).is_err());
+    }
+}
