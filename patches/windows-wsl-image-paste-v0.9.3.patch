+pub(crate) fn wsl_clipboard_paste_text(path: &str) -> String {
+    // Keep one fx image token, also safe if the user later submits it to a POSIX shell.
+    format!(
+        "\"{}\"",
+        path.replace('\\', "\\\\")
+            .replace('"', "\\\"")
+            .replace('$', "\\$")
+            .replace('`', "\\`")
+    )
+}
