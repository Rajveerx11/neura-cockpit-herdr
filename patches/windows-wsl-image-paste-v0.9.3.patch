+fn wsl_clipboard_image_batch_preserves_unrelated_input_and_resize_without_enter() {
+    use crate::protocol::ClientInputEvent;
+    use crossterm::event::{Event, KeyEvent};
+
+    let key = |code, modifiers| {
+        ClientInputEvent::from_crossterm(Event::Key(KeyEvent::new(code, modifiers))).unwrap()
+    };
+    let unrelated_key = key(
+        crossterm::event::KeyCode::Char('x'),
+        crossterm::event::KeyModifiers::NONE,
+    );
+    let ctrl_v = crate::config::parse_key_combo("ctrl+v").unwrap();
+    let nonempty_paste = ClientInputEvent::Paste {
+        text: "ordinary text".into(),
+    };
+    let text_commit = ClientInputEvent::TextCommit("typed text".into());
+    let mut batch = [
+        ClientLoopEvent::Resize(120, 40, 8, 16, true),
+        ClientLoopEvent::StdinEvents(vec![
+            unrelated_key.clone(),
+            key(ctrl_v.0, ctrl_v.1),
+            nonempty_paste.clone(),
+            ClientInputEvent::Paste {
+                text: String::new(),
+            },
+            text_commit.clone(),
+            ClientInputEvent::FocusLost,
+        ]),
+        ClientLoopEvent::Resize(121, 41, 9, 18, false),
+    ];
+    let ClientLoopEvent::StdinEvents(events) = &mut batch[1] else {
+        panic!("stdin batch")
+    };
+    replace_wsl_clipboard_image_events(events, "/mnt/c/Test User/image.png", Some(ctrl_v));
+    let image_paste = ClientInputEvent::Paste {
+        text: "\"/mnt/c/Test User/image.png\"".into(),
+    };
+    assert_eq!(
+        events,
+        &vec![
+            unrelated_key,
+            image_paste.clone(),
+            nonempty_paste,
