 pub fn read_clipboard_text() -> Option<String> {
+    const MAX_CLIPBOARD_TEXT_BYTES: usize = 1024 * 1024;
+
+    for attempt in 0..10 {
+        // Read-only access does not require a clipboard owner window.
+        if unsafe { OpenClipboard(null_mut()) } != 0 {
+            let _clipboard = ClipboardGuard;
+            let bytes = clipboard_global_bytes(CF_UNICODETEXT as u32, MAX_CLIPBOARD_TEXT_BYTES)?;
+            return clipboard_unicode_text(&bytes);
+        }
+        if attempt < 9 {
+            std::thread::sleep(Duration::from_millis(5));
+        }
+    }
     None
+}
+
+fn clipboard_unicode_text(bytes: &[u8]) -> Option<String> {
+    if !bytes.len().is_multiple_of(size_of::<u16>()) {
+        return None;
+    }
+    let units: Vec<u16> = bytes
+        .chunks_exact(2)
+        .map(|unit| u16::from_le_bytes([unit[0], unit[1]]))
+        .collect();
+    // Never scan beyond GlobalSize or accept an unterminated clipboard buffer.
+    let end = units.iter().position(|&unit| unit == 0)?;
+    String::from_utf16(&units[..end])
+        .ok()
+        .filter(|text| !text.is_empty())
 }
 
