+test "Herdr resumes only blocked reports without reviving a finished turn" {
+    // An empty socket address cannot reach a live Herdr server.
+    var client = Client{ .enabled = true };
+    client.reportState(.blocked, "question");
+    client.reportResumed(true);
+    try std.testing.expectEqual(State.working, client.reported_state.?);
+    client.reportResumed(false);
+    try std.testing.expectEqual(State.working, client.reported_state.?);
+
+    client.reportState(.blocked, "permission");
+    client.reportResumed(false);
+    try std.testing.expectEqual(State.idle, client.reported_state.?);
+
+    client.reportState(.blocked, "recovery");
+    client.reportState(.idle, null);
+    client.reportResumed(true);
+    try std.testing.expectEqual(State.idle, client.reported_state.?);
