+test "core.app_worker_runtime Herdr resumes resolved attention and preserves real blockers" {
+    const sources = [_]?worker_runtime.QuestionPromptSource{
+        null, .agent_question, .mcp_elicitation, .route_recovery,
+    };
+    for (sources) |source| {
+        for ([_]bool{ true, false }) |working| {
+            const expected: @import("../../builtins/hooks/herdr.zig").State = if (working) .working else .idle;
+            var app = FakeApp.init(std.testing.allocator);
+            defer app.deinit();
+            // Report locally through the real client, never to a live pane.
+            app.herdr.enabled = true;
+            app.worker.processing = true;
+            app.stream.active = true;
+            if (source) |question_source| {
+                app.worker.pending_question = true;
+                app.worker.pending_question_source = question_source;
+                try app.worker.pushEvent(std.heap.c_allocator, .question_requested);
+                try Runtime(FakeApp).tick(&app, NoopBridge.handlers(&app));
+            } else {
+                app.worker.pending_permission_request = .{ .id = 42, .label = "run command" };
+                Runtime(FakeApp).syncState(&app, NoopBridge.lifecyclePresenter(&app));
+            }
+            try std.testing.expectEqual(.blocked, app.herdr.reported_state.?);
+
+            // Child/background activity cannot clear a foreground prompt.
+            app.subagents.child_busy = true;
+            app.subagents.view_active = true;
+            Runtime(FakeApp).syncState(&app, NoopBridge.lifecyclePresenter(&app));
+            try std.testing.expectEqual(.blocked, app.herdr.reported_state.?);
+
+            app.worker.pending_permission_request = null;
+            app.worker.pending_question = false;
+            // Input handlers clear the UI before the next worker sync.
+            app.question_prompt.active = false;
+            app.worker.processing = working;
+            Runtime(FakeApp).syncState(&app, NoopBridge.lifecyclePresenter(&app));
+            try std.testing.expectEqual(expected, app.herdr.reported_state.?);
+            Runtime(FakeApp).syncState(&app, NoopBridge.lifecyclePresenter(&app));
+            try std.testing.expectEqual(expected, app.herdr.reported_state.?);
+        }
+    }
+}
